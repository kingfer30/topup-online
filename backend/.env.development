# 数据库连接DSN
SQL_DSN=root:123456@tcp(192.168.0.113:3316)/guo_depot?charset=utf8mb4&parseTime=True&loc=Local&timeout=10s&readTimeout=30s&writeTimeout=30s

# Redis连接字符串
REDIS_CONN_STRING=redis://:123456@localhost:6379

# 日志级别
LOG_LEVEL=info

PORT=3333

# 数据库连接池配置
SQL_MAX_IDLE_CONNS=100
SQL_MAX_OPEN_CONNS=1000
SQL_MAX_LIFETIME=60
CARD_CHECK_DISABLE=true
